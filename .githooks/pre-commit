#!/bin/sh
# Every commit raises VERSION in pm/__init__.py (AGENTS.md).
get() { git show "$1:pm/__init__.py" 2>/dev/null | sed -n 's/^VERSION = \([0-9][0-9]*\).*/\1/p'; }
new=$(get "")
old=$(get HEAD)
[ -n "$new" ] || { echo "pre-commit: no VERSION in pm/__init__.py" >&2; exit 1; }
[ "$new" -gt "${old:-0}" ] && exit 0
echo "pre-commit: raise VERSION in pm/__init__.py to $((old + 1)) (AGENTS.md)" >&2
exit 1
